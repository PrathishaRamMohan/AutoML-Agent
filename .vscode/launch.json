{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit UI",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/streamlit_app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "FastAPI backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "CLI run on sample data",
      "type": "debugpy",
      "request": "launch",
      "module": "automl_agent.cli",
      "args": ["--data", "data/sample_churn.csv", "--target", "churn", "--trials", "15"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
